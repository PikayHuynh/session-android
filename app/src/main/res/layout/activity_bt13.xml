<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ActivityBT13">

    <ImageView
        android:id="@+id/img_logo_bt13"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginStart="88dp"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="88dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/outline_4k_plus_24" />

    <TextView
        android:id="@+id/tv_title_bt13"
        android:layout_width="217dp"
        android:layout_height="56dp"
        android:layout_marginStart="105dp"
        android:layout_marginTop="29dp"
        android:layout_marginEnd="105dp"
        android:gravity="center"
        android:textColor="@color/design_default_color_primary"
        android:textSize="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_logo_bt13" />

    <Button
        android:id="@+id/btn_exit_bt13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="170dp"
        android:layout_marginTop="180dp"
        android:layout_marginEnd="170dp"
        android:contentDescription="Thoát khoải trang bài tập 13"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/auto_search_bt13" />

    <AutoCompleteTextView
        android:id="@+id/auto_search_bt13"
        android:layout_width="400dp"
        android:layout_height="48dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="43dp"
        android:layout_marginEnd="14dp"
        android:hint="Tìm kiếm phim"
        android:textSize="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_bt13" />

    <TextView
        android:id="@+id/tv_result_bt13"
        android:layout_width="300dp"
        android:layout_height="52dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="64dp"
        android:gravity="center"
        android:textColor="@color/design_default_color_primary"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/auto_search_bt13" />
</androidx.constraintlayout.widget.ConstraintLayout>