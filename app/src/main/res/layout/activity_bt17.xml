<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ActivityBT17">

    <Button
        android:id="@+id/btn_toast_simple_bt17"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginStart="154dp"
        android:layout_marginTop="329dp"
        android:layout_marginEnd="154dp"
        android:contentDescription="Toast đơn giản"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_toast_custom_bt17"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginStart="154dp"
        android:layout_marginTop="39dp"
        android:layout_marginEnd="154dp"
        android:contentDescription="Toast custom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_toast_simple_bt17" />

    <Button
        android:id="@+id/btn_exit_bt17"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginStart="154dp"
        android:layout_marginTop="39dp"
        android:layout_marginEnd="154dp"
        android:contentDescription="Thoát khỏi trang bài tập 17"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_toast_custom_bt17" />
</androidx.constraintlayout.widget.ConstraintLayout>