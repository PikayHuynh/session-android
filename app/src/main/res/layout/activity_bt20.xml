<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ActivityBT20">

    <ImageView
        android:id="@+id/img_logo_bt20"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="138dp"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="138dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/baseline_hourglass_bottom_24" />

    <TextView
        android:id="@+id/tv_result_bt20"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginStart="116dp"
        android:layout_marginTop="43dp"
        android:layout_marginEnd="116dp"
        android:gravity="center"
        android:textColor="@color/design_default_color_primary"
        android:textSize="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tp_change_hour_bt20" />

    <Button
        android:id="@+id/btn_hour_bt20"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="138dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="138dp"
        android:contentDescription="Thay đổi giờ"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_result_bt20" />

    <Button
        android:id="@+id/btn_exit_bt20"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="138dp"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="138dp"
        android:contentDescription="Thoát khỏi trang bài tập 20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_hour_bt20" />

    <TimePicker
        android:id="@+id/tp_change_hour_bt20"
        android:layout_width="204dp"
        android:layout_height="199dp"
        android:layout_marginStart="112dp"
        android:layout_marginTop="45dp"
        android:layout_marginEnd="112dp"
        android:timePickerMode="spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_logo_bt20" />

</androidx.constraintlayout.widget.ConstraintLayout>