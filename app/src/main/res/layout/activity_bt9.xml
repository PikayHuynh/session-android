<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ActivityBT9">

    <TextView
        android:id="@+id/tv_spinner_bt9"
        android:layout_width="145dp"
        android:layout_height="50dp"
        android:layout_marginStart="133dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="133dp"
        android:gravity="center"
        android:textColor="@color/material_dynamic_primary60"
        android:textSize="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_logo_bt9" />

    <ImageView
        android:id="@+id/img_logo_bt9"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="130dp"
        android:layout_marginTop="43dp"
        android:layout_marginEnd="130dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/outline_ads_click_24" />

    <Spinner
        android:id="@+id/spinner_bt9"
        android:layout_width="404dp"
        android:layout_height="77dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_spinner_bt9" />

    <Button
        android:id="@+id/btn_exit_bt9"
        android:layout_width="116dp"
        android:layout_height="59dp"
        android:layout_marginStart="155dp"
        android:layout_marginTop="98dp"
        android:layout_marginEnd="155dp"
        android:contentDescription="Thoát khỏi trang bài tập 9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinner_bt9" />
</androidx.constraintlayout.widget.ConstraintLayout>