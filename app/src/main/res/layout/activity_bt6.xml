<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ActivityBT6">

    <ImageView
        android:id="@+id/img_logo_bt6"
        android:layout_width="287dp"
        android:layout_height="356dp"
        android:layout_marginStart="62dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="62dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/kim" />

    <CheckBox
        android:id="@+id/checkbox_1_bt6"
        style="@android:style/Widget.Holo.CompoundButton.CheckBox"
        android:layout_width="160dp"
        android:layout_height="40dp"
        android:layout_marginStart="62dp"
        android:layout_marginTop="33dp"
        android:layout_marginEnd="199dp"
        android:contentDescription="Nút checkbox"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_logo_bt6" />

    <CheckBox
        android:id="@+id/checkbox_2_bt6"
        style="@android:style/Widget.Holo.CompoundButton.CheckBox"
        android:layout_width="160dp"
        android:layout_height="40dp"
        android:layout_marginStart="62dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="204dp"
        android:contentDescription="Nút checkbox"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.266"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/checkbox_1_bt6" />

    <Button
        android:id="@+id/btn_submit_bt6"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_marginStart="155dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="156dp"
        android:contentDescription="Nút submit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/checkbox_2_bt6" />

    <Button
        android:id="@+id/btn_exit_bt6"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_marginStart="155dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="156dp"
        android:contentDescription="Thoát trang bài tập 6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_submit_bt6" />
</androidx.constraintlayout.widget.ConstraintLayout>